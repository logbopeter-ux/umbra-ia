# ─────────────────────────────────────────────────────────────
#  Umbra IA — variables de déploiement (docker compose)
#  Copie ce fichier en « .env.deploy » et remplis-le.
#  ⚠️ Ne commite jamais .env.deploy.
# ─────────────────────────────────────────────────────────────

# Mot de passe d'accès — OBLIGATOIRE dès que l'app est en ligne.
# Génère-en un solide :  openssl rand -base64 24
UMBRA_PASSWORD=change-moi-par-un-mot-de-passe-solide

# Secret de signature des sessions (facultatif : sinon dérivé du mot de passe).
# Change-le pour invalider toutes les sessions en cours.
# Génère :  openssl rand -hex 32
UMBRA_SESSION_SECRET=

# ── Cerveau ──
# Clé Gemini gratuite : https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash

# ── Secours automatique ──────────────────────────────────────
# Si le principal défaille (quota, panne), Umbra enchaîne seule.
# Un secours sans clé est ignoré.
LLM_FALLBACKS=groq,claude
# Ollama : filet local, ajouté automatiquement en fin de chaîne.
# Sur un serveur sans Ollama, la sonde échoue et il est ignoré.
# OLLAMA_ENABLED=0
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Identité ──
UMBRA_USER_NAME=Monsieur
UMBRA_TIMEZONE=Africa/Porto-Novo

# ── Port sur l'hôte ──
UMBRA_PORT=4173

# ── Outils machine ──
# Sur un serveur public, on coupe l'exécution de code et le navigateur piloté.
# Sur ton propre PC (derrière un VPN ou en local), tu peux vider cette liste.
UMBRA_TOOLS_DISABLE=run_python,browser_control,system_command
