# ─────────────────────────────────────────────────────────────
#  Umbra IA — configuration
#  Copie ce fichier en « .env » puis remplis les valeurs.
#  Aucune clé n'est obligatoire : sans clé, Umbra démarre en
#  MODE DÉMO (réponses locales + outils réels).
# ─────────────────────────────────────────────────────────────

# ── 1. Cerveau (obligatoire pour la vraie IA) ─────────────────
# Gemini via AI Studio : https://aistudio.google.com/apikey
# (offre gratuite, aucune carte bancaire)
LLM_API_KEY=

# Google (OpenAI-compatible) :
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash

# Alternatives — décommente la ligne qui t'intéresse :
# OpenAI            : https://api.openai.com/v1            → LLM_MODEL=gpt-4o-mini
# OpenRouter        : https://openrouter.ai/api/v1        → LLM_MODEL=google/gemini-3.5-flash
# Groq              : https://api.groq.com/openai/v1      → LLM_MODEL=llama-3.3-70b-versatile
# Ollama (local)    : http://localhost:11434/v1           → LLM_MODEL=llama3.1 (clé vide)

# ── 2. Identité ──────────────────────────────────────────────
UMBRA_USER_NAME=Monsieur
UMBRA_LANG=fr
UMBRA_TIMEZONE=Africa/Porto-Novo

# ── 3. Réseau ────────────────────────────────────────────────
PORT=4173
# Mets 0.0.0.0 pour ouvrir Umbra à ton téléphone sur le même Wi-Fi
HOST=0.0.0.0

# ── 4. Sécurité des outils ───────────────────────────────────
# Autorise l'outil « system_command » (exécution de commandes shell).
# Désactivé par défaut. N'active que si tu sais ce que tu fais.
UMBRA_ALLOW_SHELL=0
# Préfixes autorisés si UMBRA_ALLOW_SHELL=1 (séparés par des virgules)
UMBRA_SHELL_ALLOWLIST=ls,cat,echo,pwd,date,df,uname

# ── 5. Voix temps réel (optionnel — Guide JARVIS / LiveKit) ───
# Renseignés dans livekit/.env pour l'agent vocal LiveKit + Gemini Live.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=

# ── 6. Hébergement en ligne (voir docs/INSTALL-EN-LIGNE.md) ────
# Dès que UMBRA_PASSWORD est défini, Umbra affiche une page de
# connexion et exige le mot de passe avant tout accès.
# Génère-le avec : ./scripts/generate-password.sh
UMBRA_PASSWORD=
# Secret qui signe les cookies de session. Le changer déconnecte
# tous les appareils. Génère-le avec : openssl rand -hex 32
UMBRA_SESSION_SECRET=
# 1 = verrouille les outils qui touchent la machine (recommandé en ligne)
UMBRA_PUBLIC_MODE=
# Outils désactivés, séparés par des virgules
# (run_python, browser_control, system_command, open_url…)
UMBRA_TOOLS_DISABLE=
