# ─────────────────────────────────────────────────────────────
#  Umbra IA — agent vocal (LiveKit Cloud + Gemini Live)
#  Copie ce fichier en « .env.local » et remplis les valeurs.
#  ⚠️ Ne partage JAMAIS ce fichier : il contient tes clés.
# ─────────────────────────────────────────────────────────────

# LiveKit Cloud → Settings → Keys
LIVEKIT_URL=wss://ton-projet.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio → Get API key  (offre gratuite)
GOOGLE_API_KEY=

# ── Réglages Umbra (facultatif) ───────────────────────────────
UMBRA_SERVER=http://localhost:4173
UMBRA_USER_NAME=Monsieur
UMBRA_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
UMBRA_LIVE_VOICE=Charon
UMBRA_LIVE_TEMPERATURE=0.8
# 1 = les outils risqués (notes, Python, navigateur) s'exécutent sans redemander
UMBRA_VOICE_AUTOCONFIRM=1
