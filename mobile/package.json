{
  "name": "umbra-ia-mobile",
  "version": "2.1.1",
  "private": true,
  "description": "Application Android d'Umbra IA (Capacitor)",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "postinstall": "node scripts/sync-web.mjs",
    "cap:sync": "npm run sync:web && cap sync android",
    "open": "cap open android",
    "build:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "build:release": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
